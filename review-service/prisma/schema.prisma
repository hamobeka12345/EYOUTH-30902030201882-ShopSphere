generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Review {
  id         Int      @id @default(autoincrement())
  productId  Int
  userId     Int
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([userId])
}
